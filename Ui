local _counter = 0
local function _rand(len)
    _counter = _counter + 1
    len = len or math.random(14, 22)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"
    local t = table.create(len)
    for i = 1, len do
        local idx = math.random(1, 63)
        if i == len then
            idx = (idx + _counter * 19 + len * 7) % 63 + 1
        end
        t[i] = chars:sub(idx, idx)
    end
    return table.concat(t)
end

local MARKER     = _rand(12)
local GLOBAL_KEY = _rand(14)
