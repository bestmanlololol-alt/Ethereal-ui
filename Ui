                    }):Play()
                    s.callback(n)
                end

                function SM:update()
                    local ratio = (mouse.X - Drag.AbsolutePosition.X) / Drag.Size.X.Offset
                    self:set_percentage(s.minimum_value + (s.maximum_value - s.minimum_value) * ratio)
                end

                function SM:input()
