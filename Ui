                    local r = s.round_number and math.floor(pct) or math.floor(pct * 10) / 10
                    pct = (pct - s.minimum_value) / (s.maximum_value - s.minimum_value)
                    local w = math.clamp(pct, 0.02, 1) * Drag.Size.X.Offset
                    local n = math.clamp(r, s.minimum_value, s.maximum_value)
