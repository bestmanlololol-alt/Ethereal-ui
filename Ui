            end
            if saved.colors.Accent then
                local a = C.Accent
                C.AccentSoft = Color3_.new(
                    Math_.clamp(a.R * 0.55 + 0.42, 0, 1),
                    Math_.clamp(a.G * 0.55 + 0.42, 0, 1),
