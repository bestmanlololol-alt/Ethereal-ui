        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self._dragging = true
            self._drag_start = input.Position
            self._container_position = Container.Position
            Connections["container_ended"] = input.Changed:Connect(function()
                if input.UserInputState ~= Enum.UserInputState.End then return end
                Connections:disconnect("container_ended")
                self._dragging = false
            end)
        end
    end
    local function drag(input)
        if not self._dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - self._drag_start
            TS:Create(Container, TweenInfo.new(0.2), {
                Position = UDim2.new(self._container_position.X.Scale, self._container_position.X.Offset + delta.X,
                    self._container_position.Y.Scale, self._container_position.Y.Offset + delta.Y)
            }):Play()
        end
    end

