                if Library:flag_type(s.flag, "string") then
                    TM_:update_text(Library._config._flags[s.flag])
                end

                TB.FocusLost:Connect(function() TM_:update_text(TB.Text) end)
                return TM_
            end

            -- ================================================================
            -- PARAGRAPH
            -- ================================================================
            function MM:create_paragraph(s)
                optOrder = optOrder + 1
                local PM = {}
                if MM._size == 0 then MM._size = 11 end
                MM._size = MM._size + (s.customScale or 70)
                if MM._state then Module.Size = UDim2.fromOffset(241, 93 + MM._size) end
                Options.Size = UDim2.fromOffset(241, MM._size)

                local P = Instance.new("Frame")
                P.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                P.BackgroundTransparency = 0.1
                P.Size = UDim2.new(0, 207, 0, 30)
                P.BorderSizePixel = 0
                P.AutomaticSize = Enum.AutomaticSize.Y
                P.Parent = Options
                P.LayoutOrder = optOrder

                local pC = Instance.new("UICorner")
                pC.CornerRadius = UDim.new(0, 4)
                pC.Parent = P

                local T = Instance.new("TextLabel")
                T.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)
                T.TextColor3 = Color3.fromRGB(210, 210, 210)
                T.Text = s.title or "Title"
                T.Size = UDim2.new(1, -10, 0, 20)
                T.Position = UDim2.new(0, 5, 0, 5)
                T.BackgroundTransparency = 1
                T.TextXAlignment = Enum.TextXAlignment.Left
                T.TextSize = 12
                T.AutomaticSize = Enum.AutomaticSize.XY
                T.Parent = P

                local B = Instance.new("TextLabel")
                B.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Regular)
                B.TextColor3 = Color3.fromRGB(180, 180, 180)
                if not s.rich then
                    B.Text = s.text or ""
                else
                    B.RichText = true
                    B.Text = s.richtext or ""
                end
                B.Size = UDim2.new(1, -10, 0, 20)
                B.Position = UDim2.new(0, 5, 0, 30)
                B.BackgroundTransparency = 1
                B.TextXAlignment = Enum.TextXAlignment.Left
                B.TextYAlignment = Enum.TextYAlignment.Top
                B.TextSize = 11
                B.TextWrapped = true
                B.AutomaticSize = Enum.AutomaticSize.XY
                B.Parent = P

                P.MouseEnter:Connect(function()
                    TS:Create(P, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundColor3 = Color3.fromRGB(32, 32, 32)
                    }):Play()
                end)
                P.MouseLeave:Connect(function()
                    TS:Create(P, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                    }):Play()
                end)
                return PM
            end

            -- ================================================================
            -- TEXT
            -- ================================================================
            function MM:create_text(s)
                optOrder = optOrder + 1
                local TM_ = {}
                if MM._size == 0 then MM._size = 11 end
                MM._size = MM._size + (s.customScale or 50)
                if MM._state then Module.Size = UDim2.fromOffset(241, 93 + MM._size) end
                Options.Size = UDim2.fromOffset(241, MM._size)

                local TF = Instance.new("Frame")
                TF.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                TF.BackgroundTransparency = 0.1
                TF.Size = UDim2.new(0, 207, 0, s.CustomYSize or 20)
                TF.BorderSizePixel = 0
                TF.AutomaticSize = Enum.AutomaticSize.Y
                TF.Parent = Options
                TF.LayoutOrder = optOrder

                local tC = Instance.new("UICorner")
                tC.CornerRadius = UDim.new(0, 4)
                tC.Parent = TF

                local B = Instance.new("TextLabel")
                B.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Regular)
                B.TextColor3 = Color3.fromRGB(180, 180, 180)
                if not s.rich then B.Text = s.text or "" else B.RichText = true; B.Text = s.richtext or "" end
                B.Size = UDim2.new(1, -10, 1, 0)
                B.Position = UDim2.new(0, 5, 0, 5)
                B.BackgroundTransparency = 1
                B.TextXAlignment = Enum.TextXAlignment.Left
                B.TextYAlignment = Enum.TextYAlignment.Top
                B.TextSize = 10
                B.TextWrapped = true
                B.AutomaticSize = Enum.AutomaticSize.XY
                B.Parent = TF

                TF.MouseEnter:Connect(function()
                    TS:Create(TF, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundColor3 = Color3.fromRGB(32, 32, 32)
                    }):Play()
                end)
                TF.MouseLeave:Connect(function()
                    TS:Create(TF, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                    }):Play()
                end)

                function TM_:Set(ns)
                    if not ns.rich then B.Text = ns.text or ""
                    else B.RichText = true; B.Text = ns.richtext or "" end
                end
                return TM_
            end

            -- ================================================================
            -- DROPDOWN
            -- ================================================================
            function MM:create_dropdown(s)
                if not s.Order then optOrder = optOrder + 1 end
                local DM = { _state = false, _size = 0 }
                if not s.Order then
                    if MM._size == 0 then MM._size = 11 end
                    MM._size = MM._size + 44
                    if MM._state then Module.Size = UDim2.fromOffset(241, 93 + MM._size) end
                    Options.Size = UDim2.fromOffset(241, MM._size)
                end
                if not Library._config._flags[s.flag] then Library._config._flags[s.flag] = {} end

                local Dropdown = Instance.new("TextButton")
                Dropdown.Text = ""
                Dropdown.AutoButtonColor = false
                Dropdown.BackgroundTransparency = 1
                Dropdown.Name = "Dropdown"
                Dropdown.Size = UDim2.new(0, 207, 0, 39)
                Dropdown.BorderSizePixel = 0
                Dropdown.Parent = Options
                Dropdown.LayoutOrder = s.Order and s.OrderValue or optOrder

                local TL = Instance.new("TextLabel")
                TL.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)
                TL.TextSize = 11
                TL.TextColor3 = Colors.Text
                TL.TextTransparency = 0.2
                TL.Text = s.title
                TL.Size = UDim2.new(0, 207, 0, 13)
                TL.BackgroundTransparency = 1
                TL.TextXAlignment = Enum.TextXAlignment.Left
                TL.Parent = Dropdown

                local Box = Instance.new("Frame")
                Box.ClipsDescendants = true
                Box.AnchorPoint = Vector2.new(0.5, 0)
                Box.BackgroundTransparency = 0.9
                Box.Position = UDim2.new(0.5, 0, 1.2, 0)
                Box.Name = "Box"
                Box.Size = UDim2.new(0, 207, 0, 22)
                Box.BorderSizePixel = 0
                Box.BackgroundColor3 = Colors.Accent
                Box.Parent = TL

                local bxC = Instance.new("UICorner")
                bxC.CornerRadius = UDim.new(0, 4)
                bxC.Parent = Box

                local Header = Instance.new("Frame")
                Header.AnchorPoint = Vector2.new(0.5, 0)
                Header.BackgroundTransparency = 1
                Header.Position = UDim2.new(0.5, 0, 0, 0)
                Header.Size = UDim2.new(0, 207, 0, 22)
                Header.BorderSizePixel = 0
                Header.Parent = Box

                local CurrentOption = Instance.new("TextLabel")
                CurrentOption.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)
                CurrentOption.TextColor3 = Colors.Text
                CurrentOption.TextTransparency = 0.2
                CurrentOption.Name = "CurrentOption"
                CurrentOption.Size = UDim2.new(0, 161, 0, 13)
                CurrentOption.AnchorPoint = Vector2.new(0, 0.5)
                CurrentOption.Position = UDim2.new(0.05, 0, 0.5, 0)
                CurrentOption.BackgroundTransparency = 1
                CurrentOption.TextXAlignment = Enum.TextXAlignment.Left
                CurrentOption.TextSize = 10
                CurrentOption.Parent = Header

                local coG = Instance.new("UIGradient")
                coG.Transparency = NumberSequence.new{
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(0.7, 0),
                    NumberSequenceKeypoint.new(0.87, 0.36),
                    NumberSequenceKeypoint.new(1, 1)
                }
                coG.Parent = CurrentOption

                local Arrow = Instance.new("ImageLabel")
                Arrow.AnchorPoint = Vector2.new(0, 0.5)
                Arrow.Image = "rbxassetid://84232453189324"
                Arrow.BackgroundTransparency = 1
                Arrow.Position = UDim2.new(0.91, 0, 0.5, 0)
                Arrow.Name = "Arrow"
                Arrow.Size = UDim2.new(0, 8, 0, 8)
                Arrow.BorderSizePixel = 0
                Arrow.Parent = Header

                local OptList = Instance.new("ScrollingFrame")
                OptList.Active = true
                OptList.ScrollBarImageTransparency = 1
                OptList.AutomaticCanvasSize = Enum.AutomaticSize.XY
                OptList.ScrollBarThickness = 0
                OptList.Name = "Options"
                OptList.Size = UDim2.new(0, 207, 0, 0)
                OptList.BackgroundTransparency = 1
                OptList.Position = UDim2.new(0, 0, 1, 0)
                OptList.BorderSizePixel = 0
                OptList.CanvasSize = UDim2.new(0, 0, 0.5, 0)
                OptList.Parent = Box

                local oL = Instance.new("UIListLayout")
                oL.SortOrder = Enum.SortOrder.LayoutOrder
                oL.Parent = OptList

                local oP = Instance.new("UIPadding")
                oP.PaddingTop = UDim.new(0, -1)
                oP.PaddingLeft = UDim.new(0, 10)
                oP.Parent = OptList

                local bL = Instance.new("UIListLayout")
                bL.SortOrder = Enum.SortOrder.LayoutOrder
                bL.Parent = Box

                function DM:update(opt)
                    if s.multi_dropdown then
                        if not Library._config._flags[s.flag] then Library._config._flags[s.flag] = {} end
                        local cv = #Library._config._flags[s.flag] > 0 and convertTableToString(Library._config._flags[s.flag])
                        local selected = {}
                        if cv then
                            for v in string.gmatch(cv, "([^,]+)") do
                                local t = v:match("^%s*(.-)%s*$")
                                if t ~= "Label" then table.insert(selected, t) end
                            end
                        else
                            for v in string.gmatch(CurrentOption.Text, "([^,]+)") do
                                local t = v:match("^%s*(.-)%s*$")
                                if t ~= "Label" then table.insert(selected, t) end
                            end
                        end
                        local ctg = convertStringToTable(CurrentOption.Text)
                        local optName = typeof(opt) ~= "string" and opt.Name or opt
                        for i, v in pairs(ctg) do
                            if v == optName then table.remove(ctg, i); break end
                        end
                        CurrentOption.Text = table.concat(selected, ", ")
                        local oc = {}
                        for _, o in OptList:GetChildren() do
                            if o.Name == "Option" then
                                table.insert(oc, o.Text)
                                o.TextTransparency = table.find(selected, o.Text) and 0.2 or 0.6
                            end
                        end
                        cv = convertStringToTable(CurrentOption.Text)
                        for _, v in cv do
                            if not table.find(oc, v) and table.find(selected, v) then table.remove(selected, _) end
                        end
                        CurrentOption.Text = table.concat(selected, ", ")
                        Library._config._flags[s.flag] = convertStringToTable(CurrentOption.Text)
                    else
                        CurrentOption.Text = typeof(opt) == "string" and opt or opt.Name
                        for _, o in OptList:GetChildren() do
                            if o.Name == "Option" then
                                o.TextTransparency = o.Text == CurrentOption.Text and 0.2 or 0.6
                            end
                        end
                        Library._config._flags[s.flag] = opt
                    end
                    Config:save(game.GameId, Library._config)
                    s.callback(opt)
                end

                function DM:unfold()
                    self._state = not self._state
                    if self._state then
                        MM._multiplier = MM._multiplier + self._size
                        TS:Create(Module, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(241, 93 + MM._size + MM._multiplier)
                        }):Play()
                        TS:Create(Options, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(241, MM._size + MM._multiplier)
                        }):Play()
                        TS:Create(Dropdown, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(207, 39 + self._size)
                        }):Play()
                        TS:Create(Box, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(207, 22 + self._size)
                        }):Play()
                        TS:Create(Arrow, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = 180 }):Play()
                    else
                        MM._multiplier = MM._multiplier - self._size
                        TS:Create(Module, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(241, 93 + MM._size + MM._multiplier)
                        }):Play()
                        TS:Create(Options, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(241, MM._size + MM._multiplier)
                        }):Play()
                        TS:Create(Dropdown, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(207, 39)
                        }):Play()
                        TS:Create(Box, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(207, 22)
                        }):Play()
                        TS:Create(Arrow, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
                    end
                end

                if #s.options > 0 then
                    DM._size = 3
                    for i, v in s.options do
                        local Opt = Instance.new("TextButton")
                        Opt.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)
                        Opt.Active = false
                        Opt.TextTransparency = 0.6
                        Opt.AnchorPoint = Vector2.new(0, 0.5)
                        Opt.TextSize = 10
                        Opt.Size = UDim2.new(0, 186, 0, 16)
                        Opt.TextColor3 = Colors.Text
                        Opt.Text = typeof(v) == "string" and v or v.Name
                        Opt.AutoButtonColor = false
                        Opt.Name = "Option"
                        Opt.BackgroundTransparency = 1
                        Opt.TextXAlignment = Enum.TextXAlignment.Left
                        Opt.Selectable = false
                        Opt.Position = UDim2.new(0.05, 0, 0.342, 0)
                        Opt.BorderSizePixel = 0
                        Opt.Parent = OptList

                        local oG = Instance.new("UIGradient")
                        oG.Transparency = NumberSequence.new{
                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(0.7, 0),
                            NumberSequenceKeypoint.new(0.87, 0.36),
                            NumberSequenceKeypoint.new(1, 1)
                        }
                        oG.Parent = Opt

                        Opt.MouseButton1Click:Connect(function()
                            if not Library._config._flags[s.flag] then Library._config._flags[s.flag] = {} end
                            if s.multi_dropdown then
                                if table.find(Library._config._flags[s.flag], v) then
                                    Library:remove_table_value(Library._config._flags[s.flag], v)
                                else
                                    table.insert(Library._config._flags[s.flag], v)
                                end
                            end
                            DM:update(v)
                        end)

                        if i > s.maximum_options then continue end
                        DM._size = DM._size + 16
                        OptList.Size = UDim2.fromOffset(207, DM._size)
                    end
                end

                if Library:flag_type(s.flag, "string") then
                    DM:update(Library._config._flags[s.flag])
                else
                    DM:update(s.options[1])
                end

                Dropdown.MouseButton1Click:Connect(function() DM:unfold() end)
                return DM
            end

            return MM
        end

        return TM
    end

    Connections["vis"] = UIS.InputBegan:Connect(function(input, process)
        if process then return end
        if input.KeyCode ~= Enum.KeyCode.Insert then return end
        self._ui_open = not self._ui_open
        self:change_visiblity(self._ui_open)
    end)

    Minimize.MouseButton1Click:Connect(function()
        self._ui_open = not self._ui_open
        self:change_visiblity(self._ui_open)
    end)

    return self
end

return Library
