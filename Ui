            function moduleApi.scale_keybind(_, empty)
                if Library._config._keybinds[moduleOptions.flag] and not empty then
                    local text = Library._config._keybinds[moduleOptions.flag]:gsub("Enum.KeyCode.", "")
                    local params = IB.new("GetTextBoundsParams")
                    params.Text = text
                    params.Font = Font.new("rbxasset://fonts/families/Montserrat.json", Enum_.FontWeight.Bold)
                    params.Size = 10
                    params.Width = 10000
                    local bounds = TextService:GetTextBoundsAsync(params)
                    keybindBox.Size = UDim2_.fromOffset(bounds.X + 6, 15)
                    keybindLabel.Size = UDim2_.fromOffset(bounds.X, 13)
                else
                    keybindBox.Size = UDim2_.fromOffset(31, 15)
