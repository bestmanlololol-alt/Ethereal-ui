            for key, hsv in pairs_(saved.colors) do
                if type_(hsv) == "table" and hsv.H ~= nil and Lib.Colors[key] then
                    Lib.Colors[key] = Color3_.fromHSV(hsv.H, hsv.S, hsv.V)
                end
