                dragFill.BorderSizePixel = 0
                dragFill.BackgroundColor3 = Colors.Accent
                dragFill.Parent = dragTrack
                local dfCorner = IB.new("UICorner")
                dfCorner.CornerRadius = UDim_.new(0, 3)
                dfCorner.Parent = dragFill
                local dfGradient = IB.new("UIGradient")
                dfGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Colors.AccentSoft),
                    ColorSequenceKeypoint.new(1, Colors.AccentDim),
                })
                dfGradient.Parent = dragFill

                local dragKnob = IB.new("Frame")
                dragKnob.AnchorPoint = Vector2.new(1, 0.5)
                dragKnob.Name = "Circle"
                dragKnob.Position = UDim2_.new(1, 0, 0.5, 0)
                dragKnob.Size = UDim2_.new(0, 7, 0, 7)
                dragKnob.BorderSizePixel = 0
                dragKnob.BackgroundColor3 = Colors.AccentSoft
                dragKnob.Parent = dragFill
                local dkCorner = IB.new("UICorner")
                dkCorner.CornerRadius = UDim_.new(0, 12)
                dkCorner.Parent = dragKnob

                local valueLabel = IB.new("TextLabel")
                valueLabel.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum_.FontWeight.SemiBold)
                valueLabel.TextColor3 = Color3_.fromRGB(235, 235, 245)
                valueLabel.TextTransparency = 0.2
                valueLabel.Text = "0"
                valueLabel.Name = "Value"
                valueLabel.Size = UDim2_.new(0, 42, 0, 13)
                valueLabel.AnchorPoint = Vector2.new(1, 0)
                valueLabel.Position = UDim2_.new(1, 0, 0, 0)
                valueLabel.BackgroundTransparency = 1
                valueLabel.TextXAlignment = Enum_.TextXAlignment.Right
                valueLabel.TextSize = 10
                valueLabel.Parent = row

                local api = {
                    set_percentage = function(self, value)
                        local rounded = Math_.floor(Math_.clamp(value, opts.minimum_value, opts.maximum_value) * multiplier + 0.5) / multiplier
                        local ratio = Math_.clamp((rounded - opts.minimum_value) / (opts.maximum_value - opts.minimum_value), 0.02, 1)
                        local fillWidth = ratio * dragTrack.Size.X.Offset
                        Library._config._flags[opts.flag] = rounded
                        valueLabel.Text = format(rounded)
                        TweenService:Create(dragFill, TweenInfo.new(0.5, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), {
                            Size = UDim2_.fromOffset(fillWidth, dragTrack.Size.Y.Offset),
                        }):Play()
                        opts.callback(rounded)
                    end,
                    update = function(self)
                        local ratio = Math_.clamp((mouse.X - dragTrack.AbsolutePosition.X) / dragTrack.Size.X.Offset, 0, 1)
                        self:set_percentage(opts.minimum_value + (opts.maximum_value - opts.minimum_value) * ratio)
                    end,
                    input = function(self)
                        self:update()
                        Connections["slider_drag_" .. opts.flag] = mouse.Move:Connect(function()
                            self:update()
                        end)
                        Connections["slider_input_" .. opts.flag] = UserInputService.InputEnded:Connect(function(input)
                            if input.UserInputType ~= Enum_.UserInputType.MouseButton1
                                and input.UserInputType ~= Enum_.UserInputType.Touch then return end
                            Connections:disconnect("slider_drag_" .. opts.flag)
                            Connections:disconnect("slider_input_" .. opts.flag)
                            if not opts.ignoresaved then
                                Config:save(game_.GameId, Library._config)
                            end
                        end)
                    end,
                }

                if Library:flag_type(opts.flag, "number") and not opts.ignoresaved then
                    api:set_percentage(Library._config._flags[opts.flag])
                else
                    api:set_percentage(opts.value)
                end

                row.MouseButton1Down:Connect(function()
                    api:input()
                end)

                return api
            end

