-- Build a random identifier string. The last char is deterministic based on
-- an incrementing counter so re-executions don't produce identical names.
local function randomId(length)
    _randomCounter = _randomCounter + 1
    length = length or Math_.random(14, 22)
    local chars = {}
    for i = 1, length do
        local idx = Math_.random(1, 63)
        if i == length then
            idx = (idx + _randomCounter * 19 + length * 7) % 63 + 1
        end
        chars[i] = String_.sub(
            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_",
            idx, idx
        )
    end
    return Table_.concat(chars)
end

-- Shorter random identifier for attribute markers.
local function randomMarker(length)
    _randomCounter = _randomCounter + 1
    length = length or Math_.random(12, 18)
    local chars = {}
    for i = 1, length do
        local idx = Math_.random(1, 63)
        if i == length then
            idx = (idx + _randomCounter * 23) % 63 + 1
        end
        chars[i] = String_.sub(
            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_",
            idx, idx
        )
    end
    return Table_.concat(chars)
end

-- The two random names this session will use across all GUI trees.
local GLOBAL_KEY      = randomId(Math_.random(14, 22))
local MARKER_ATTR     = randomMarker(Math_.random(12, 18))

-- Get a hidden UI container. Prefers gethui() — invisible to game scripts.
local function getHiddenContainer()
    local hidden
    pcall_(function()
        if typeof_(gethui) ~= "function" then return end
        hidden = gethui()
        if hidden and typeof_(cloneref) == "function" then
            hidden = cloneref(hidden)
        end
    end)
    return hidden or CoreGui
end

-- Call fn for every place a GUI might live (for sweeping/cleanup).
local function forEachGuiContainer(fn)
    fn(getHiddenContainer())
    fn(CoreGui)
    fn(Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui"))
end

-- Create an instance with a random name. Used for every GUI object.
local function newInstance(className)
    _instanceCounter = _instanceCounter + 1
    local inst = Instance_.new(className)
    inst.Name = randomId(Math_.random(14, 22))
    return inst
end

-- Classes we want to random-name. Everything else uses normal Instance.new.
local RANDOM_NAME_CLASSES = {
    ScreenGui = true, BillboardGui = true, SurfaceGui = true,
    Frame = true, ScrollingFrame = true, TextLabel = true,
    TextButton = true, TextBox = true, ImageLabel = true,
    ImageButton = true, ViewportFrame = true, VideoFrame = true,
    CanvasGroup = true, Folder = true, UICorner = true,
    UIStroke = true, UIGradient = true, UIPadding = true,
    UIListLayout = true, UIGridLayout = true,
    UIAspectRatioConstraint = true, UITextSizeConstraint = true,
    UISizeConstraint = true, UIScale = true,
    UIPageLayout = true, UITableLayout = true,
}

local function createInstance(className, ...)
    if RANDOM_NAME_CLASSES[className] then
        return newInstance(className)
    end
    return Instance_.new(className, ...)
end

-- Proxy so `.new` calls go through the randomizer but everything else stays
-- the same (e.g. Instance.fromExisting still works).
local InstanceProxy = setmetatable({}, {
    __index = function(_, key)
        if key == "new" then return createInstance end
        return Instance_[key]
    end
})

-- Tag a GUI with our random attribute + register in getgenv for cleanup.
local function registerGuiRoot(root)
    if not root then return end
    root:SetAttribute(MARKER_ATTR, randomMarker(Math_.random(14, 22)))
    _lastGuiRoot = root

    if getgenv_ then
        getgenv_()[GLOBAL_KEY] = root
        getgenv_()._AllusiveObfuscationRegistry = {
            GuiRoot = root,
            GlobalKey = GLOBAL_KEY,
            MarkerAttribute = MARKER_ATTR,
        }
    end
end

-- Sweep any orphaned ScreenGui carrying our marker attribute.
local function sweepOrphanedGuis()
    forEachGuiContainer(function(container)
        if not container then return end
        for _, child in container:GetChildren() do
            if child:IsA("ScreenGui") and child:GetAttribute(MARKER_ATTR) ~= nil then
                child:Destroy()
            end
        end
    end)
end

-- Full cleanup from registry.
local function destroyRegistry()
    if not getgenv_ then return end
    local registry = getgenv_()._AllusiveObfuscationRegistry
    if typeof_(registry) ~= "table" then return end

    if typeof_(registry.GuiRoot) == "Instance" and registry.GuiRoot.Parent then
        pcall_(function() registry.GuiRoot:Destroy() end)
    end

    if typeof_(registry.GlobalKey) == "string" then
        local g = getgenv_()[registry.GlobalKey]
        if typeof_(g) == "Instance" and g.Parent then
            pcall_(function() g:Destroy() end)
        end
        getgenv_()[registry.GlobalKey] = nil
    end

    if typeof_(registry.MarkerAttribute) == "string" then
        local marker = registry.MarkerAttribute
        forEachGuiContainer(function(container)
            if not container then return end
            for _, child in container:GetChildren() do
                if child:IsA("ScreenGui") and child:GetAttribute(marker) ~= nil then
                    child:Destroy()
                end
            end
        end)
    end
end

-- Public cleanup.
local function destroyAll()
    destroyRegistry()
    sweepOrphanedGuis()

    if getgenv_ and GLOBAL_KEY then
        local ref = getgenv_()[GLOBAL_KEY]
        if typeof_(ref) == "Instance" and ref.Parent then
            ref:Destroy()
        end
        getgenv_()[GLOBAL_KEY] = nil
    end

    if _lastGuiRoot and _lastGuiRoot.Parent then
        _lastGuiRoot:Destroy()
    end
    _lastGuiRoot = nil
end

-- Create a ScreenGui inside the hidden container, fully tagged.
local function createHiddenScreenGui()
    local gui = newInstance("ScreenGui")
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum_.ZIndexBehavior.Sibling
    gui.Parent = getHiddenContainer()
    registerGuiRoot(gui)
    return gui
end

-- Create a ScreenGui with marker attribute but NOT added to registry.
-- Used for temporary previews / helper GUIs.
local function createTemporaryScreenGui()
    local gui = newInstance("ScreenGui")
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum_.ZIndexBehavior.Sibling
    gui:SetAttribute(MARKER_ATTR, randomMarker(Math_.random(14, 22)))
    gui.Parent = getHiddenContainer()
    return gui
end

