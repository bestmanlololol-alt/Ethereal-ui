    -- ----- Drag logic -----
    local function onDragBegan(input)
        if Library._blocking_drag then return end
        if input.UserInputType ~= Enum_.UserInputType.MouseButton1
            and input.UserInputType ~= Enum_.UserInputType.Touch then return end

        self._dragging = true
        self._drag_start = input.Position
        self._container_position = container.Position

        Connections.container_input_ended = input.Changed:Connect(function()
            if input.UserInputState ~= Enum_.UserInputState.End then return end
            Connections:disconnect("container_input_ended")
            self._dragging = false
        end)
    end

    local function onDragMoved(input)
        if not self._dragging or Library._blocking_drag then return end
        if input.UserInputType ~= Enum_.UserInputType.MouseMovement
            and input.UserInputType ~= Enum_.UserInputType.Touch then return end

        local delta = input.Position - self._drag_start
        TweenService:Create(container, TweenInfo.new(0.2), {
            Position = UDim2_.new(
                self._container_position.X.Scale,
                self._container_position.X.Offset + delta.X,
                self._container_position.Y.Scale,
                self._container_position.Y.Offset + delta.Y
            ),
        }):Play()
    end

    Connections.container_input_began = container.InputBegan:Connect(onDragBegan)
    Connections.input_changed = UserInputService.InputChanged:Connect(onDragMoved)

    self:removed(function()
        self._ui = nil
        Connections:disconnect_all()
    end)

