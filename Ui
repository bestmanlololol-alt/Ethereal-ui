-- ============================================================================
-- Section 6: Device / screen utilities
-- ============================================================================
function Library.get_screen_scale(self)
    local ratio = workspace_.CurrentCamera.ViewportSize.X / 1400
    if self._device == "Mobile" then
        self._ui_scale = Math_.clamp(ratio * 0.97, 0.68, 0.9)
    else
        self._ui_scale = Math_.clamp(ratio, 0.5, 1.2)
    end
end

function Library.get_device(self)
    if not UserInputService.TouchEnabled and UserInputService.KeyboardEnabled and UserInputService.MouseEnabled then
        self._device = "PC"
    elseif UserInputService.TouchEnabled then
        self._device = "Mobile"
    elseif UserInputService.GamepadEnabled then
        self._device = "Console"
    else
        self._device = "Unknown"
    end
end

function Library.removed(self, action)
    self._ui.AncestryChanged:Once(action)
end

function Library.flag_type(_, flag, expectedType)
    if not Library._config._flags[flag] then return end
    return typeof_(Library._config._flags[flag]) == expectedType
end

function Library.remove_table_value(_, tbl, value)
    for i, v in tbl do
        if v == value then
            Table_.remove(tbl, i)
            return
        end
    end
end

function Library.new()
    local self = setmetatable({ _loaded = false }, Library)
    self:create_ui()
    return self
end

