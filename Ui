                if not Library._config._keybinds[moduleOptions.flag] then return end
                Connections[moduleOptions.flag .. "_keybind"] = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if tostring_(input.KeyCode) ~= Library._config._keybinds[moduleOptions.flag] then return end
                    moduleApi:change_state(not moduleApi._state)
                end)
