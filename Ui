local Connections = {}
function Connections:disconnect(key)
    if not self[key] then return end
    self[key]:Disconnect()
    self[key] = nil
end
function Connections:disconnect_all()
    for k, v in self do
        if k ~= "disconnect" and k ~= "disconnect_all" and typeof(v) ~= "function" then
            v:Disconnect()
        end
    end
end

local function convertStringToTable(s)
    local r = {}
    for v in string.gmatch(s, "([^,]+)") do
        table.insert(r, v:match("^%s*(.-)%s*$"))
    end
    return r
end
local function convertTableToString(t) return table.concat(t, ", ") end

