local Config = {}
Config.__index = Config

function Config.save(_, gameId, data)
    local ok, err = pcall_(function()
        writefile("Allusive/" .. gameId .. ".json", HttpService:JSONEncode(data))
    end)
    if not ok then
        warn("failed to save config", err)
    end
end

function Config.load(self, gameId, defaults)
    local ok, result = pcall_(function()
        if not isfile("Allusive/" .. gameId .. ".json") then
            self:save(gameId, defaults)
            return
        end

        local contents = readfile("Allusive/" .. gameId .. ".json")
        if not contents then
            self:save(gameId, defaults)
            return
        end

        return HttpService:JSONDecode(contents)
    end)

    if not ok then
        warn("failed to load config", result)
    end

    return result or { _flags = {}, _keybinds = {}, _library = {} }
end

