    function self:UIVisiblity()
        screenGui.Enabled = not screenGui.Enabled
    end

    function self:change_visiblity(open)
        self._vis_seq = (self._vis_seq or 0) + 1
        local seq = self._vis_seq
        local isHiding = not open
        local isPC = self._device == "PC"
        local shouldHide = isPC and Library._config._gui and Library._config._gui.hide_minimized
        local scale = self._container_uiscale
        local normalScale = self._ui_scale or 1

        if isHiding and shouldHide then
            if scale then
                TweenService:Create(scale, TweenInfo.new(0.34, Enum_.EasingStyle.Quint, Enum_.EasingDirection.In), { Scale = 0.04 }):Play()
                Task_.delay(0.36, function()
                    if seq ~= self._vis_seq then return end
                    if not self._ui_open then
                        screenGui.Enabled = false
                        scale.Scale = normalScale
                    end
                end)
            else
                screenGui.Enabled = false
            end
            return
        end

        screenGui.Enabled = true

        if open and scale then
            scale.Scale = 0.04
            TweenService:Create(scale, TweenInfo.new(0.34, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), { Scale = normalScale }):Play()
        end

        local targetSize = open and UDim2_.fromOffset(698, 479) or UDim2_.fromOffset(104.5, 52)
        TweenService:Create(container, TweenInfo.new(0.34, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), { Size = targetSize }):Play()
    end

    function self:load()
        local images = {}
        for _, obj in screenGui:GetDescendants() do
            if obj:IsA("ImageLabel") then
                Table_.insert(images, obj)
            end
        end
        ContentProvider:PreloadAsync(images)

        self:get_device()
        if self._device == "Mobile" or self._device == "Unknown" then
            self:get_screen_scale()
            containerScale.Scale = self._ui_scale
            Connections.ui_scale = workspace_.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                self:get_screen_scale()
                containerScale.Scale = self._ui_scale
            end)
        end

        TweenService:Create(container, TweenInfo.new(0.55, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), {
            Size = UDim2_.fromOffset(698, 479),
        }):Play()
        self._ui_loaded = true
    end

    function self:update_tabs(tab, animate)
        local shouldAnimate = animate ~= false
        self._active_tab_ref = tab

        for _, child in tabList:GetChildren() do
            if child.Name ~= "Tab" then continue end
            child.BackgroundColor3 = Colors.CardDeep

            local indicator = child:FindFirstChild("Indicator")
            local label = child:FindFirstChildOfClass("TextLabel")
            local labelGradient = label and label:FindFirstChildOfClass("UIGradient")
            local icon = child:FindFirstChild("Icon")
            local active = child == tab

            child:SetAttribute("_active", active)

            if shouldAnimate then
                local easing = TweenInfo.new(active and 0.32 or 0.28, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out)

                TweenService:Create(child, easing, { BackgroundTransparency = active and 0.82 or 1 }):Play()
                if label then
                    TweenService:Create(label, easing, {
                        TextTransparency = active and 0 or 0.42,
                        TextColor3 = active and Colors.Accent or Colors.Text,
                    }):Play()
                end
                if labelGradient then
                    TweenService:Create(labelGradient, easing, { Offset = Vector2.new(active and 1 or 0, 0) }):Play()
                end
                if icon then
                    TweenService:Create(icon, easing, {
                        ImageTransparency = active and 0 or 0.5,
                        ImageColor3 = active and Colors.Accent or Colors.Text,
                    }):Play()
                end
                if indicator then
                    indicator.BackgroundColor3 = Colors.Accent
                    TweenService:Create(indicator, TweenInfo.new(active and 0.42 or 0.22, active and Enum_.EasingStyle.Back or Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), {
                        BackgroundTransparency = active and 0 or 1,
                        Size = UDim2_.new(0, 3, 0, active and 22 or 10),
                    }):Play()
                end
            else
                child.BackgroundTransparency = active and 0.82 or 1
                if label then
                    label.TextTransparency = active and 0 or 0.42
                    label.TextColor3 = active and Colors.Accent or Colors.Text
                end
                if labelGradient then labelGradient.Offset = Vector2.new(active and 1 or 0, 0) end
                if icon then
                    icon.ImageTransparency = active and 0 or 0.5
                    icon.ImageColor3 = active and Colors.Accent or Colors.Text
                end
                if indicator then
                    indicator.BackgroundColor3 = Colors.Accent
                    indicator.BackgroundTransparency = active and 0 or 1
                    indicator.Size = UDim2_.new(0, 3, 0, active and 22 or 10)
                end
            end
        end
    end

    function self:update_sections(left, right)
