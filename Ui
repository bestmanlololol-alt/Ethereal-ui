                        BackgroundColor3 = Lib.Colors.SubText,
                    }):Play()
                    moduleApi._ab_tween = TweenService:Create(accentBar, TweenInfo.new(0.45, Enum_.EasingStyle.Quint, Enum_.EasingDirection.Out), {
