local function container()
    local h
    pcall(function()
        if typeof(gethui) ~= "function" then return end
        h = gethui()
        if h and typeof(cloneref) == "function" then h = cloneref(h) end
    end)
    return h or CoreGui
end

local function purge_old()
    local reg = getgenv()._EReg
    if reg then
        if typeof(reg.Main) == "Instance" and reg.Main.Parent then
            pcall(function() reg.Main:Destroy() end)
        end
        if typeof(reg.Notif) == "Instance" and reg.Notif.Parent then
            pcall(function() reg.Notif:Destroy() end)
        end
        if typeof(reg.Key) == "string" and getgenv()[reg.Key] then
            pcall(function()
                local g = getgenv()[reg.Key]
                if typeof(g) == "Instance" and g.Parent then g:Destroy() end
            end)
            getgenv()[reg.Key] = nil
        end
        getgenv()._EReg = nil
    end
    for _, c in ipairs({ container(), CoreGui }) do
        if c then
            for _, child in ipairs(c:GetChildren()) do
                if child:IsA("ScreenGui") and child:GetAttribute(MARKER) ~= nil then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end
purge_old()
if not isfolder(FOLDER) then makefolder(FOLDER) end

