            local C = Lib.Colors
            if saved.colors.Stroke then
                local s = C.Stroke
                C.StrokeHot = Color3_.new(
                    Math_.clamp(s.R * 1.2 + 0.05, 0, 1),
                    Math_.clamp(s.G * 1.2 + 0.05, 0, 1),
                    Math_.clamp(s.B * 1.22 + 0.06, 0, 1)
