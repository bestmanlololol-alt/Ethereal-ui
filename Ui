local Config = {}
function Config:save(name, data)
    pcall(function() writefile(FOLDER.."/"..name..".json", HS:JSONEncode(data)) end)
end
function Config:load(name)
    local ok, result = pcall(function()
        if not isfile(FOLDER.."/"..name..".json") then return end
        return HS:JSONDecode(readfile(FOLDER.."/"..name..".json"))
    end)
    return (ok and result) or { _flags = {}, _keybinds = {}, _library = {} }
end

